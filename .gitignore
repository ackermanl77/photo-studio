# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
venv[0-9]*/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Build & release output
build-release/
dist-release/
build-venv/
build-release-self-test.json
dist/
build/
PhotoStudio-*-Windows/
PhotoStudio-*-Windows.zip
PhotoStudio-*-Windows.7z
PhotoStudio-*-Windows.7z.sha256
PhotoStudio-*-GPU-pack.7z
PhotoStudio-*-GPU-pack.7z.sha256
build-release-gpu-pack-self-test.json
/release-gpu-pack/
*.spec.bak

# Fixed-name mirror of the current PhotoStudio-<version>-Windows/ build output (see
# scripts/build_release.ps1) -- always the latest build, so PhotoStudio.exe has one stable place
# to find it regardless of version.
/release/

# Downloaded/extracted third-party runtime bundled into releases (see scripts/build_release.ps1)
# -- large binary, fetched on demand, never committed.
vendor/

# Runtime data / logs
.photo-studio/
*.log

# Claude Code local-only config (personal permissions, not shared)
.claude/settings.local.json

# OS
Thumbs.db
Desktop.ini
